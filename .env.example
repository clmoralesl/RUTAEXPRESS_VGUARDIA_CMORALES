# Azure AD / Entra ID Config
AZURE_TENANT_ID="xxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
AZURE_FRONTEND_CLIENT_ID="xxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
AZURE_BACKEND_CLIENT_ID="xxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
AZURE_BACKEND_SCOPE="api://xxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx/access_as_user"
AZURE_REDIRECT_URI="http://localhost:4200"

# Oracle Cloud Database Configuration
ORACLE_DB_URL="jdbc:oracle:thin:@rutaexpressdb_high?TNS_ADMIN=/path/to/wallet"
ORACLE_WALLET_LOCATION="/path/to/wallet"

# Esquema 1: Envíos (Sprint 1 - ms-rutaexpress-envios)
ORACLE_ENVIOS_USERNAME="USER_ENVIOS"
ORACLE_ENVIOS_PASSWORD="xxxxxxxxxxxx"

# Esquema 2: Catálogo (Sprint 2 - ms-rutaexpress-catalogo)
ORACLE_CATALOGO_USERNAME="USER_CATALOGO"
ORACLE_CATALOGO_PASSWORD="xxxxxxxxxxxx"

# Esquema 3: Auditoría (Sprint 2 - ms-rutaexpress-auditoria)
ORACLE_AUDITORIA_USERNAME="USER_AUDITORIA"
ORACLE_AUDITORIA_PASSWORD="xxxxxxxxxxxx"

# Alias Genérico para ms-rutaexpress-envios
ORACLE_DB_USERNAME="USER_ENVIOS"
ORACLE_DB_PASSWORD="xxxxxxxxxxxx"
