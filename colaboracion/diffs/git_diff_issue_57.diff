+DECLARE
+    v_nulos NUMBER := 0;
+BEGIN
+    SELECT COUNT(*) INTO v_nulos
+    FROM USER_ENVIOS.ENVIOS
+    WHERE id_comuna_origen IS NULL OR id_comuna_destino IS NULL;
+
+    IF v_nulos > 0 THEN
+        RAISE_APPLICATION_ERROR(-20003, 'Existen ' || v_nulos || ' filas con comuna nula tras el backfill. No se puede proceder con el cierre de la migracion.');
+    END IF;
+END;
+/
+
+-- -----------------------------------------------------------------------------
+-- PASO 7: Consulta de reconciliacion visual con evaluacion automatica de coincidencia
+-- -----------------------------------------------------------------------------
+SELECT 
+    e.id,
+    e.codigo_seguimiento,
+    e.direccion_origen AS origen_legacy,
+    (e.calle_origen || ' ' || e.numero_origen || ', ' || co.nombre) AS origen_nuevo,
+    CASE WHEN INSTR(UPPER(e.direccion_origen), UPPER(e.calle_origen)) > 0
+          AND INSTR(UPPER(e.direccion_origen), UPPER(co.nombre)) > 0
+         THEN 'OK' ELSE 'REVISAR' END AS coincide_origen,
+    e.direccion_destino AS destino_legacy,
+    (e.calle_destino || ' ' || e.numero_destino || ', ' || cd.nombre) AS destino_nuevo,
+    CASE WHEN INSTR(UPPER(e.direccion_destino), UPPER(e.calle_destino)) > 0
+          AND INSTR(UPPER(e.direccion_destino), UPPER(cd.nombre)) > 0
+         THEN 'OK' ELSE 'REVISAR' END AS coincide_destino
+FROM USER_ENVIOS.ENVIOS e
+JOIN USER_ENVIOS.COMUNAS co ON co.id_comuna = e.id_comuna_origen
+JOIN USER_ENVIOS.COMUNAS cd ON cd.id_comuna = e.id_comuna_destino
+ORDER BY e.id;
+
+PROMPT =============================================================================
+PROMPT FASE A COMPLETADA EXITOSAMENTE.
+PROMPT REVISAR LOS RESULTADOS ANTERIORES.
+PROMPT SI TODAS LAS FILAS TIENEN 'OK' O LAS DIFERENCIAS SON ACEPTABLES, PROCEDER CON:
+PROMPT @07b_migracion_direcciones_envios_cierre.sql
+PROMPT =============================================================================

diff --git a/infra/oracle/07b_migracion_direcciones_envios_cierre.sql b/infra/oracle/07b_migracion_direcciones_envios_cierre.sql
new file mode 100644
--- /dev/null
+++ b/infra/oracle/07b_migracion_direcciones_envios_cierre.sql
@@ -0,0 +1,103 @@
+-- =============================================================================
+-- Script: 07b_migracion_direcciones_envios_cierre.sql
+-- Descripcion: Fase B de migracion: Restricciones NOT NULL, eliminacion segura
+--              de columnas legadas (DROP COLUMN) y actualizacion de comentarios.
+-- Proyecto: RutaExpress (Issue #57)
+-- Esquema: USER_ENVIOS
+-- Dependencia: Requiere ejecucion y revision visual previa de 07a_migracion_direcciones_envios.sql
+-- =============================================================================
+
+WHENEVER SQLERROR EXIT FAILURE ROLLBACK;
+ALTER SESSION SET CURRENT_SCHEMA = USER_ENVIOS;
+
+-- -----------------------------------------------------------------------------
+-- PASO 1: Verificacion de pre-requisitos de Fase A y existencia de respaldo
+-- -----------------------------------------------------------------------------
+DECLARE
+    v_nulos NUMBER := 0;
+    v_cols  NUMBER := 0;
+    v_bkp_existe NUMBER := 0;
+    v_bkp_filas  NUMBER := 0;
+BEGIN
+    -- Validar que la tabla de respaldo exista en USER_ENVIOS y no este vacia
+    SELECT COUNT(*) INTO v_bkp_existe
+    FROM ALL_TABLES
+    WHERE owner = 'USER_ENVIOS' AND table_name = 'ENVIOS_BKP_ISSUE57';
+
+    IF v_bkp_existe = 0 THEN
+        RAISE_APPLICATION_ERROR(-20006, 'No existe la tabla de respaldo USER_ENVIOS.ENVIOS_BKP_ISSUE57. Ejecute primero 07a_migracion_direcciones_envios.sql.');
+    END IF;
+
+    EXECUTE IMMEDIATE 'SELECT COUNT(*) FROM USER_ENVIOS.ENVIOS_BKP_ISSUE57' INTO v_bkp_filas;
+    IF v_bkp_filas = 0 THEN
+        RAISE_APPLICATION_ERROR(-20007, 'La tabla de respaldo USER_ENVIOS.ENVIOS_BKP_ISSUE57 esta vacia. Abortando cierre por proteccion de datos.');
+    END IF;
+
+    -- Validar existencia de las columnas estructuradas en USER_ENVIOS.ENVIOS
+    SELECT COUNT(*) INTO v_cols
+    FROM ALL_TAB_COLS
+    WHERE owner = 'USER_ENVIOS'
+      AND table_name = 'ENVIOS' 
+      AND column_name IN ('CALLE_ORIGEN', 'NUMERO_ORIGEN', 'ID_COMUNA_ORIGEN',
+                          'CALLE_DESTINO', 'NUMERO_DESTINO', 'ID_COMUNA_DESTINO');
+
+    IF v_cols < 6 THEN
+        RAISE_APPLICATION_ERROR(-20004, 'No se han creado todas las columnas estructuradas requeridas en USER_ENVIOS.ENVIOS. Ejecute primero 07a_migracion_direcciones_envios.sql.');
+    END IF;
+
+    -- Validar que no existan valores nulos
+    SELECT COUNT(*) INTO v_nulos
+    FROM USER_ENVIOS.ENVIOS
+    WHERE calle_origen IS NULL 
+       OR numero_origen IS NULL 
+       OR id_comuna_origen IS NULL
+       OR calle_destino IS NULL 
+       OR numero_destino IS NULL 
+       OR id_comuna_destino IS NULL;
+
+    IF v_nulos > 0 THEN
+        RAISE_APPLICATION_ERROR(-20005, 'Existen ' || v_nulos || ' filas con columnas estructuradas nulas. Abortando cierre de migracion.');
+    END IF;
+END;
+/
+
+-- -----------------------------------------------------------------------------
+-- PASO 2: Aplicacion de restricciones NOT NULL
+-- -----------------------------------------------------------------------------
+ALTER TABLE USER_ENVIOS.ENVIOS MODIFY (
+    calle_origen      NOT NULL,
+    numero_origen     NOT NULL,
+    id_comuna_origen  NOT NULL,
+    calle_destino     NOT NULL,
+    numero_destino    NOT NULL,
+    id_comuna_destino NOT NULL
+);
+
+-- -----------------------------------------------------------------------------
+-- PASO 3: Eliminacion de columnas desnormalizadas antiguas
+-- -----------------------------------------------------------------------------
+ALTER TABLE USER_ENVIOS.ENVIOS DROP (
+    direccion_origen,
+    direccion_destino
+);
+
+-- -----------------------------------------------------------------------------
+-- PASO 4: Actualizacion de comentarios de documentacion del diccionario de datos
+-- -----------------------------------------------------------------------------
+COMMENT ON COLUMN USER_ENVIOS.ENVIOS.codigo_seguimiento IS 'Codigo unico institucional de rastreo con formato RTX-YYYY-XXXXXX';
+COMMENT ON COLUMN USER_ENVIOS.ENVIOS.calle_origen IS 'Nombre de calle, avenida o pasaje de origen';
+COMMENT ON COLUMN USER_ENVIOS.ENVIOS.numero_origen IS 'Numero municipal o S/N de origen';
+COMMENT ON COLUMN USER_ENVIOS.ENVIOS.complemento_origen IS 'Depto, oficina, block o referencia opcional de origen';
+COMMENT ON COLUMN USER_ENVIOS.ENVIOS.id_comuna_origen IS 'Codigo CUT de la comuna de origen (FK a COMUNAS)';
+COMMENT ON COLUMN USER_ENVIOS.ENVIOS.calle_destino IS 'Nombre de calle, avenida o pasaje de destino';
+COMMENT ON COLUMN USER_ENVIOS.ENVIOS.numero_destino IS 'Numero municipal o S/N de destino';
+COMMENT ON COLUMN USER_ENVIOS.ENVIOS.complemento_destino IS 'Depto, oficina, block o referencia opcional de destino';
+COMMENT ON COLUMN USER_ENVIOS.ENVIOS.id_comuna_destino IS 'Codigo CUT de la comuna de destino (FK a COMUNAS)';
+
+COMMIT;
+
+PROMPT =============================================================================
+PROMPT FASE B (CIERRE) COMPLETADA EXITOSAMENTE.
+PROMPT LAS COLUMNAS DESNORMALIZADAS FUERON ELIMINADAS.
+PROMPT EL ESQUEMA USER_ENVIOS.ENVIOS HA SIDO TOTALMENTE NORMALIZADO.
+PROMPT =============================================================================

diff --git a/infra/oracle/08_rollback_direcciones_issue57.sql b/infra/oracle/08_rollback_direcciones_issue57.sql
new file mode 100644
--- /dev/null
+++ b/infra/oracle/08_rollback_direcciones_issue57.sql
@@ -0,0 +1,204 @@
+-- =============================================================================
+-- Script: 08_rollback_direcciones_issue57.sql
+-- Descripcion: Procedimiento de Rollback resiliente de la normalizacion de direcciones.
+--              Capaz de revertir tanto un cierre completo (post 07b) como un estado
+--              parcial interrumpido (post 07a).
+-- Proyecto: RutaExpress (Issue #57)
+-- Esquema: USER_ENVIOS
+-- =============================================================================
+
+WHENEVER SQLERROR EXIT FAILURE ROLLBACK;
+ALTER SESSION SET CURRENT_SCHEMA = USER_ENVIOS;
+
+-- -----------------------------------------------------------------------------
+-- PASO 1: Validar existencia e integridad de la tabla de respaldo
+-- -----------------------------------------------------------------------------
+DECLARE
+    v_existe NUMBER := 0;
+    v_filas  NUMBER := 0;
+BEGIN
+    SELECT COUNT(*) INTO v_existe 
+    FROM ALL_TABLES 
+    WHERE owner = 'USER_ENVIOS' AND table_name = 'ENVIOS_BKP_ISSUE57';
+
+    IF v_existe = 0 THEN
+        RAISE_APPLICATION_ERROR(-20003, 'No existe la tabla de respaldo USER_ENVIOS.ENVIOS_BKP_ISSUE57. Rollback cancelado para proteger los datos.');
+    END IF;
+
+    EXECUTE IMMEDIATE 'SELECT COUNT(*) FROM USER_ENVIOS.ENVIOS_BKP_ISSUE57' INTO v_filas;
+    IF v_filas = 0 THEN
+        RAISE_APPLICATION_ERROR(-20004, 'La tabla de respaldo USER_ENVIOS.ENVIOS_BKP_ISSUE57 se encuentra vacia. Rollback cancelado.');
+    END IF;
+END;
+/
+
+-- -----------------------------------------------------------------------------
+-- PASO 2: Reincorporar columnas legacy condicionalmente (solo si fueron eliminadas)
+-- -----------------------------------------------------------------------------
+DECLARE
+    v_cols NUMBER := 0;
+BEGIN
+    SELECT COUNT(*) INTO v_cols
+    FROM ALL_TAB_COLS
+    WHERE owner = 'USER_ENVIOS' AND table_name = 'ENVIOS' AND column_name = 'DIRECCION_ORIGEN';
+
+    IF v_cols = 0 THEN
+        EXECUTE IMMEDIATE 'ALTER TABLE USER_ENVIOS.ENVIOS ADD (direccion_origen VARCHAR2(255), direccion_destino VARCHAR2(255))';
+    END IF;
+END;
+/
+
+-- -----------------------------------------------------------------------------
+-- PASO 3: Restaurar direcciones originales desde el respaldo por ID
+-- -----------------------------------------------------------------------------
+MERGE INTO USER_ENVIOS.ENVIOS e
+USING USER_ENVIOS.ENVIOS_BKP_ISSUE57 b
+ON (e.id = b.id)
+WHEN MATCHED THEN
+    UPDATE SET e.direccion_origen = b.direccion_origen,
+               e.direccion_destino = b.direccion_destino;
+
+-- -----------------------------------------------------------------------------
+-- PASO 4: Para envios nuevos creados post-migracion, recomponer la direccion legacy
+--         (si las columnas estructuradas existen)
+-- -----------------------------------------------------------------------------
+DECLARE
+    v_cols NUMBER := 0;
+BEGIN
+    SELECT COUNT(*) INTO v_cols
+    FROM ALL_TAB_COLS
+    WHERE owner = 'USER_ENVIOS' AND table_name = 'ENVIOS' AND column_name = 'CALLE_ORIGEN';
+
+    IF v_cols > 0 THEN
+        EXECUTE IMMEDIATE '
+            UPDATE USER_ENVIOS.ENVIOS e
+            SET e.direccion_origen = (
+                    SELECT TRIM(e.calle_origen || '' '' || e.numero_origen || 
+                           NVL2(e.complemento_origen, '', '' || e.complemento_origen, '''') || 
+                           NVL2(c.nombre, '', '' || c.nombre, '''') ||
+                           NVL2(r.nombre, '', '' || r.nombre, ''''))
+                    FROM USER_ENVIOS.COMUNAS c
+                    LEFT JOIN USER_ENVIOS.REGIONES r ON r.id_region = c.id_region
+                    WHERE c.id_comuna = e.id_comuna_origen
+                ),
+                e.direccion_destino = (
+                    SELECT TRIM(e.calle_destino || '' '' || e.numero_destino || 
+                           NVL2(e.complemento_destino, '', '' || e.complemento_destino, '''') || 
+                           NVL2(c.nombre, '', '' || c.nombre, '''') ||
+                           NVL2(r.nombre, '', '' || r.nombre, ''''))
+                    FROM USER_ENVIOS.COMUNAS c
+                    LEFT JOIN USER_ENVIOS.REGIONES r ON r.id_region = c.id_region
+                    WHERE c.id_comuna = e.id_comuna_destino
+                )
+            WHERE e.direccion_origen IS NULL OR e.direccion_destino IS NULL';
+    END IF;
+END;
+/
+
+COMMIT;
+
+-- -----------------------------------------------------------------------------
+-- PASO 5: Validar que no queden valores nulos antes de aplicar NOT NULL
+-- -----------------------------------------------------------------------------
+DECLARE
+    v_nulos NUMBER := 0;
+BEGIN
+    SELECT COUNT(*) INTO v_nulos 
+    FROM USER_ENVIOS.ENVIOS 
+    WHERE direccion_origen IS NULL OR direccion_destino IS NULL;
+
+    IF v_nulos > 0 THEN
+        RAISE_APPLICATION_ERROR(-20005, 'Existen filas con direccion_origen o direccion_destino nulas tras reconstruccion. Abortando rollback.');
+    END IF;
+END;
+/
+
+-- -----------------------------------------------------------------------------
+-- PASO 6: Restaurar restricciones NOT NULL en columnas legacy condicionalmente
+--         (evita ORA-01442 si el script 07a fallo antes de DROP COLUMN)
+-- -----------------------------------------------------------------------------
+DECLARE
+    v_nullables NUMBER := 0;
+BEGIN
+    SELECT COUNT(*) INTO v_nullables
+    FROM ALL_TAB_COLS
+    WHERE owner = 'USER_ENVIOS'
+      AND table_name = 'ENVIOS'
+      AND column_name IN ('DIRECCION_ORIGEN', 'DIRECCION_DESTINO')
+      AND nullable = 'Y';
+
+    IF v_nullables > 0 THEN
+        FOR c IN (SELECT column_name FROM ALL_TAB_COLS
+                  WHERE owner = 'USER_ENVIOS'
+                    AND table_name = 'ENVIOS'
+                    AND column_name IN ('DIRECCION_ORIGEN', 'DIRECCION_DESTINO')
+                    AND nullable = 'Y') LOOP
+            EXECUTE IMMEDIATE 'ALTER TABLE USER_ENVIOS.ENVIOS MODIFY (' || c.column_name || ' NOT NULL)';
+        END LOOP;
+    END IF;
+END;
+/
+
+-- -----------------------------------------------------------------------------
+-- PASO 7: Eliminar restricciones de clave foranea e indices nuevos condicionalmente
+-- -----------------------------------------------------------------------------
+DECLARE
+    v_count NUMBER;
+BEGIN
+    SELECT COUNT(*) INTO v_count FROM ALL_CONSTRAINTS WHERE owner = 'USER_ENVIOS' AND constraint_name = 'FK_ENVIOS_COMUNA_ORIGEN';
+    IF v_count > 0 THEN
+        EXECUTE IMMEDIATE 'ALTER TABLE USER_ENVIOS.ENVIOS DROP CONSTRAINT fk_envios_comuna_origen';
+    END IF;
+
+    SELECT COUNT(*) INTO v_count FROM ALL_CONSTRAINTS WHERE owner = 'USER_ENVIOS' AND constraint_name = 'FK_ENVIOS_COMUNA_DESTINO';
+    IF v_count > 0 THEN
+        EXECUTE IMMEDIATE 'ALTER TABLE USER_ENVIOS.ENVIOS DROP CONSTRAINT fk_envios_comuna_destino';
+    END IF;
+
+    SELECT COUNT(*) INTO v_count FROM ALL_INDEXES WHERE owner = 'USER_ENVIOS' AND index_name = 'IDX_ENVIOS_COMUNA_ORIGEN';
+    IF v_count > 0 THEN
+        EXECUTE IMMEDIATE 'DROP INDEX USER_ENVIOS.idx_envios_comuna_origen';
+    END IF;
+
+    SELECT COUNT(*) INTO v_count FROM ALL_INDEXES WHERE owner = 'USER_ENVIOS' AND index_name = 'IDX_ENVIOS_COMUNA_DESTINO';
+    IF v_count > 0 THEN
+        EXECUTE IMMEDIATE 'DROP INDEX USER_ENVIOS.idx_envios_comuna_destino';
+    END IF;
+END;
+/
+
+-- -----------------------------------------------------------------------------
+-- PASO 8: Eliminar columnas normalizadas condicionalmente si existen
+-- -----------------------------------------------------------------------------
+DECLARE
+    v_cols NUMBER := 0;
+BEGIN
+    SELECT COUNT(*) INTO v_cols
+    FROM ALL_TAB_COLS
+    WHERE owner = 'USER_ENVIOS' AND table_name = 'ENVIOS' AND column_name = 'CALLE_ORIGEN';
+
+    IF v_cols > 0 THEN
+        EXECUTE IMMEDIATE '
+            ALTER TABLE USER_ENVIOS.ENVIOS DROP (
+                calle_origen,
